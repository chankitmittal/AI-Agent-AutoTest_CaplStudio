testcase PDU_AccelGravityLatitude_timeout_test()
{
  // PDU Name - "PDU_AccelGravityLatitude"
  // Fault type - "TIMEOUT"
  // debounce time - 6000 ms
  // recovery time - 3000 ms
  // DTC Number - 0x535353
  check_message_fault("PDU_AccelGravityLatitude", "TIMEOUT", 6000, 3000, 0x535353);
}

